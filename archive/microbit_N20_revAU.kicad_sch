 (text "REV AN: USB is internal to micro:bit; no USB VBUS net may connect to robot 5V." (at 25 740 0) (effects (font (size 1.4 1.4))) (uuid "de85f06a-7b66-4a85-8f99-aff291bb3eb9"))
 (text "J7 is LOGICAL ONLY: do not fabricate an 80-contact footprint from this symbol." (at 25 750 0) (effects (font (size 1.4 1.4))) (uuid "f7efc51d-cd35-4df9-92ca-00d5ada7376f"))
 (text "J6: 3.0V battery-JST harness only; verify polarity, source limits and backfeed on bench." (at 25 760 0) (effects (font (size 1.4 1.4))) (uuid "cf185926-ec8d-4e24-8dbd-f19fe9d9c436"))
